# URL of your deployed Cloudflare Worker proxy (no trailing slash)
PROXY_URL=https://osrs-proxy.your-subdomain.workers.dev

# Shared secret used to authenticate with the proxy
# Must exactly match the PROXY_SECRET set on the Cloudflare Worker
PROXY_SECRET=replace-with-a-long-random-string

# Optional: port for the local Express server (default 3000)
PORT=3000

# Optional: Eldorado.gg seller API credentials (dashboard -> Seller API).
# Enables the "Publish to Eldorado" button. There is no sandbox: offers go to your live account.
ELDORADO_CLIENT_ID=
ELDORADO_CLIENT_SECRET=

# Optional: folder holding one subfolder per account to list, named "<RSN>" or "<RSN> - hcim"
# (also uim, im/iron, main). Each subfolder holds the screenshots and one .txt file (email:password:key, any name).
# Picking a folder in the app loads everything; after publishing it moves to <ACCOUNTS_DIR>\Listed.
ACCOUNTS_DIR=
# Optional: where published account folders are moved (default: <ACCOUNTS_DIR>\Listed).
LISTED_DIR=
